# ---- LLM: GitHub Models (OpenAI-compatible) ----
# Create a GitHub fine-grained PAT with the "Models" permission (read).
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4o-mini

# ---- Embeddings: BGE-M3 (multilingual ru/ky/en) ----
# Runs locally inside the backend container (CPU). Needs ~3-4 GB RAM.
# Lighter fallback if RAM is tight: intfloat/multilingual-e5-small (set EMBED_DIM=384)
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=alatoo_kb
# QDRANT_API_KEY=        # set if you secure Qdrant

# ---- Retrieval / generation tuning ----
TOP_K=5
SCORE_THRESHOLD=0.3
MAX_CONTEXT_CHARS=8000

# ---- Backend ----
# Leave empty so the public chat page works without a key.
# If set, /v1 requests must send "Authorization: Bearer <key>" (used by OpenWebUI).
BACKEND_API_KEY=
SERVED_MODEL_NAME=alatoo-rag
