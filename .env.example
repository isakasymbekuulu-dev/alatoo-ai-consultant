# ---- LLM: GitHub Models (OpenAI-compatible) ----
# Create a GitHub fine-grained PAT with the "Models" permission (read).
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4o-mini

# ---- Embeddings ----
# Local BGE-M3 (best ky/ru/en), needs ~3-4 GB RAM:
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# API alternative (no local model, low RAM) — uncomment to use instead:
# EMBED_MODEL=openai/text-embedding-3-small
# EMBED_DIM=1536

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=alatoo_kb
# QDRANT_API_KEY=        # set if you secure Qdrant

# ---- Retrieval / generation tuning ----
TOP_K=5
SCORE_THRESHOLD=0.3
MAX_CONTEXT_CHARS=8000

# ---- Backend ----
# Leave empty so the public chat page works without a key.
# If set, /v1 requests must send "Authorization: Bearer <key>" (used by OpenWebUI).
BACKEND_API_KEY=
SERVED_MODEL_NAME=alatoo-rag

# ---- Conversation logging ----
# Token that protects the log viewer at /admin/logs?token=...  (set a long random value)
ADMIN_TOKEN=

# Public chat rate limit (requests per minute per IP)
RATE_LIMIT_PER_MIN=20

# ---- OpenWebUI (managed in docker-compose) ----
# Reuse the existing key so staff sessions stay valid after recreation.
WEBUI_SECRET_KEY=change-me

# --- WhatsApp Cloud API (Meta) channel ---
# Set these as GitHub Secrets (deploy.yml writes them into .env on the server):
#   WHATSAPP_TOKEN, WHATSAPP_VERIFY_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET
WHATSAPP_VERIFY_TOKEN=        # any random string; must match Meta webhook "Verify token"
WHATSAPP_TOKEN=              # Cloud API access token (System User token recommended)
WHATSAPP_PHONE_NUMBER_ID=    # e.g. 1155572644311757 (test number)
WHATSAPP_APP_SECRET=         # optional: enables X-Hub-Signature-256 verification
